{
  "name": "liftx-site-v1",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-15",
  "limits": {
    "cpu_ms": 30000
  },
  "vars": {
    "VISUALIZER_ENABLED": "true"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/visualizer/*"
    ]
  },
  "ratelimits": [
    {
      "name": "VISUALIZER_RATE_LIMITER",
      "namespace_id": "220260918",
      "simple": { "limit": 2, "period": 60 }
    },
    {
      "name": "VISUALIZER_GLOBAL_RATE_LIMITER",
      "namespace_id": "220260919",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
